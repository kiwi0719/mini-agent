# ---------------------------------------------------------------------------
# mini-agent 凭证模板
# 用法：cp .env.example .env，填上你要用的那一段，其余留空/删掉。
# 重要：本项目不会自动加载 .env，必须用 node --env-file=.env 启动（见 TESTING.md §3）。
# .env 已被 .gitignore 忽略，不会提交。
# ---------------------------------------------------------------------------

# --- 不配任何 key 也能跑：Mock LLM ---
# LLM_PROVIDER=mock

# --- A. Anthropic 协议（官方 / 网关 / Kimi / GLM / DeepSeek / MiniMax）---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx      # 走 x-api-key 头
# ANTHROPIC_AUTH_TOKEN=xxxxxxxx          # 只认 Authorization: Bearer 的网关用这个
# ANTHROPIC_PRESET=anthropic             # anthropic | kimi | glm | deepseek | minimax | custom
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_STREAM=true                  # 填 false 关流式（SSE 不稳的网关）

# --- B. OpenAI 协议（OpenAI / DeepSeek / Qwen / OpenRouter / vLLM / Ollama）---
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# --- C. 默认 provider / flavor（省得每次敲 -p）---
# LLM_PROVIDER=anthropic                 # anthropic | openai | local | mock
# LLM_FLAVOR=ollama                      # openai | vllm | ollama（provider=local/openai 时生效）

# --- D. 仅 scripts/run-real-model.ts 用（OpenRouter 一个 key 跑两条协议）---
# OR_KEY=sk-or-v1-xxxxxxxx               # 或写 OPENROUTER_API_KEY

# --- E. 其他可调项 ---
# PORT=3000                              # Web 端口
# AGENT_WORKERS=2                        # Web 并发 Worker 数
# WORKSPACE=/absolute/path/to/workspace   # 覆盖 Web 使用的 workspace 目录
# MOCK_DELAY_MS=400                      # 让 mock 变慢，方便观察排队/中止
